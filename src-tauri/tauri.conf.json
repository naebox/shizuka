{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shizuka",
  "version": "0.4.0",
  "identifier": "app.shizuka.audio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shizuka",
        "width": 380,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "naebox",
    "homepage": "https://github.com/naebox/shizuka",
    "copyright": "Copyright (c) 2026 naebox",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Local Real-Time AI Microphone Noise Cancellation",
    "longDescription": "Shizuka is a local real-time AI microphone noise cancellation app powered by DeepFilterNet3 and Neural VAD Gate.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNEZGODZBQzRFQzE1MDQKUldRRUZlekVhdmhQSVNMbEpRV2pMbHIrZW9JbGJ1ZHpoLzFBZHBQdzRLS3FURllpbDd1UXFtajQK",
      "endpoints": [
        "https://github.com/naebox/shizuka/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
